#!/usr/bin/env bash
# ===================================================================
#  站点配置（可选）—— 复制成 wsl-env.sh 后按需取消注释
#
#  被 scripts/wsl-server.sh 自动读取（文件存在才读）。wsl-env.sh 本身
#  已在 .gitignore 里，**不会**被提交，所以密钥放这里不会被公开。
#
#  为什么要有这个文件：SECRET_KEY / DEBUG / 主机名单原先写死在
#  cipher_platform/settings.py 里 —— 改配置要改代码，而且密钥会跟着源码
#  进版本库。现在它们改从环境变量读（见 settings.py 顶部那一节），
#  这里就是"演示 / 部署时到底该设哪些"的集中处。
#
#  全部注释掉 = 回到源码里的开发默认值，行为与以前完全一样。
# ===================================================================

# ── 生产密钥 ────────────────────────────────────────────────────────
# 正式部署必须换掉。生成一份新的：
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# export DJANGO_SECRET_KEY='把你生成的那一串粘进来'

# ── 调试开关 ────────────────────────────────────────────────────────
# 设成 0 会同时关掉 Django 的调试报错页（现场演示时就不会把配置细节、
# 路径、SQL 露给观众）。
# ⚠️ 关掉之前确认静态文件有人服务：本项目在 WSL 里装了 whitenoise，
#    一般直接可用；若那个环境没装，页面会整片 404（白屏）。
# export DJANGO_DEBUG=0

# ── 允许访问的主机 ──────────────────────────────────────────────────
# 逗号分隔。DEBUG 下默认是 *；关掉 DEBUG 后默认只剩 127.0.0.1 / localhost，
# 这时若要从别的机器访问、或用 WSL 的 IP 兜底通道，必须显式加上：
# export DJANGO_ALLOWED_HOSTS='127.0.0.1,localhost,172.31.83.172'

# ── 写请求的跨源白名单 ──────────────────────────────────────────────
# 换端口 / 换域名 / 经 WSL 的 IP 访问时都要加上，**必须带 scheme**，
# 否则 POST 会被 CSRF 中间件 403：
# export DJANGO_CSRF_TRUSTED_ORIGINS='http://127.0.0.1:5173,http://172.31.83.172:8011'

# ── 服务监听（一般不用改）───────────────────────────────────────────
# export PORT=8011
# export HOST=0.0.0.0
